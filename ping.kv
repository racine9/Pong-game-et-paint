#:kivy 2.3.1
<Pong>:
    canvas:
        Rectangle:
            pos: self.center_x - 10, 0
            size: 10, self.height
        ellipse:
            size: 20, 20
            pos: 100, 100
    Label:
        font_size: 70
        center_x: root.width / 4
        top: root.top - 50
        text: "0"
    Label:
        font_size: 70
        center_x: root.width * 3 / 4
        top: root.top - 50
        text: "0"
